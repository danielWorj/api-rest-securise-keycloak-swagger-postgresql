    {
      "id": 13,
      "type": "timeseries",
      "title": "Volume des logs de l'API par niveau",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({service=\"api\"}[1m]))",
          "legendFormat": "{{level}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
