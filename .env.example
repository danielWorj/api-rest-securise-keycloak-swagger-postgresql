# Copier ce fichier en .env puis remplacer TOUTES les valeurs (ne jamais versionner .env)

# --- Base de données de l'API ---
DB_NAME=banque
DB_USER=banque_user
DB_PASSWORD=changez-moi
DB_HOST=localhost          # forcé à "postgres" par docker-compose
DB_PORT=5432

# --- Base de données de Keycloak ---
KC_DB_NAME=keycloak
KC_DB_USER=keycloak_user
KC_DB_PASSWORD=changez-moi

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changez-moi
KEYCLOAK_PORT=8585
KEYCLOAK_PUBLIC_URL=http://localhost:8585     # prod : https://auth.votre-domaine (sans /realms/...)
KEYCLOAK_INTERNAL_URL=http://localhost:8585   # forcé à http://keycloak:8080 par docker-compose
KEYCLOAK_REALM=banque
KEYCLOAK_SWAGGER_CLIENT_ID=swagger-ui

# --- API ---
SERVER_PORT=8282
JPA_DDL_AUTO=update        # dev uniquement ; en prod : validate + migrations
JPA_SHOW_SQL=false
SWAGGER_ENABLED=true       # false en production
APP_CORS_ORIGINS=http://localhost:3000

# --- Observabilité (docker-compose.observability.yaml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changez-moi
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- Production (docker-compose.prod.yaml) ---
# API_IMAGE=ghcr.io/danielworj/api-rest-securise-keycloak-swagger-postgresql
# API_TAG=latest
